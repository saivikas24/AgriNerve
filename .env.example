# AgriNerve environment configuration
# Copy this file to .env and replace the placeholders with your local values.
# Never commit the real .env file.

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/agrinerve

# JWT authentication
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gmail SMTP (used for email/OTP features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# Application
DEBUG=true
